{
  "__comment": "The Forge operations dashboard. Nine panels, each answering one operational question -- the row layout IS the mental model: how much work (top), who is doing it (middle), how well is it going (bottom).",
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 12, "showPoints": "never" } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(forge_jobs_submitted_total[1m]))", "legendFormat": "submitted/s" },
        { "expr": "sum(rate(forge_jobs_completed_total[1m]))", "legendFormat": "completed/s" }
      ],
      "title": "Throughput: in vs out",
      "description": "When submitted/s outruns completed/s for long, the queue-depth panel to the right is about to explain where the difference went.",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 25, "stacking": { "mode": "normal" }, "showPoints": "never" } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum by (priority) (forge_queue_depth)", "legendFormat": "ready ({{priority}})" },
        { "expr": "sum(forge_queue_delayed_depth)", "legendFormat": "delayed (backoff/scheduled)" }
      ],
      "title": "Queue depth",
      "description": "Ready work by priority, plus everything waiting out a backoff. This is the number the autoscaler steers by.",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 12, "showPoints": "never" } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(forge_queue_inflight)", "legendFormat": "in flight (claimed, unacked)" },
        { "expr": "sum(forge_queue_dlq_depth)", "legendFormat": "dead-letter log" }
      ],
      "title": "In flight & DLQ",
      "description": "In-flight tracks the claimed-but-unfinished set (the consumer group PEL). A rising DLQ line is a page, not a curiosity.",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 12, "showPoints": "never" } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(forge_worker_active_jobs)", "legendFormat": "active (fleet)" },
        { "expr": "sum(forge_worker_target_concurrency)", "legendFormat": "capacity (fleet)" }
      ],
      "title": "Fleet load vs capacity",
      "description": "Active hugging capacity means saturated workers (queue wait is growing); capacity moving on its own is the autoscaler working.",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "forge_worker_active_jobs", "legendFormat": "{{worker}}" }
      ],
      "title": "Active jobs per worker",
      "description": "One line per worker. A flat-zero line among busy peers is a worker that stopped fetching -- paused, draining, or wedged.",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0, "custom": { "fillOpacity": 12, "showPoints": "never" } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "avg(forge_worker_utilization)", "legendFormat": "fleet avg" },
        { "expr": "max(forge_worker_utilization)", "legendFormat": "hottest worker" }
      ],
      "title": "Worker utilization",
      "description": "Sustained ~1.0 with queue depth growing = add workers. Sustained near-zero = the autoscaler will shrink, or should.",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(forge_job_e2e_duration_seconds_bucket[2m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(forge_job_e2e_duration_seconds_bucket[2m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(forge_job_e2e_duration_seconds_bucket[2m])) by (le))", "legendFormat": "p99" }
      ],
      "title": "End-to-end latency (enqueue → done)",
      "description": "What a submitter experiences, queue wait included.",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "id": 8,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(forge_job_e2e_duration_seconds_bucket[2m])) by (le))", "legendFormat": "e2e p95" },
        { "expr": "histogram_quantile(0.95, sum(rate(forge_job_duration_seconds_bucket[2m])) by (le))", "legendFormat": "execution p95" }
      ],
      "title": "The queue-wait gap (p95)",
      "description": "The distance between these lines is time spent WAITING, not working. Execution flat while e2e climbs = you need capacity, not faster handlers.",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 12, "showPoints": "never" } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "id": 9,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(forge_jobs_retried_total[1m]))", "legendFormat": "retries/s" },
        { "expr": "sum(rate(forge_jobs_failed_total[1m]))", "legendFormat": "permanent failures/s" },
        { "expr": "sum(rate(forge_jobs_dead_lettered_total[1m]))", "legendFormat": "dead-lettered/s" },
        { "expr": "sum(rate(forge_writes_fenced_total[1m]))", "legendFormat": "fenced writes/s" }
      ],
      "title": "Failures, retries, fences",
      "description": "Retries are normal in moderation. Fenced writes should be near zero outside chaos tests -- each one is a zombie worker meeting the fence.",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["forge"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "utc",
  "title": "Forge — Job Platform",
  "uid": "forge-main",
  "version": 1
}
