# Compose reads this as .env (cp .env.example .env).

# Required: bearer tokens the API accepts, comma-separated. Generate one:
#   openssl rand -hex 24
CALLIGRAPHY_API_TOKENS=

# Optional: HMAC secret signing http.callback deliveries. The receiving
# app verifies X-Calligraphy-Signature with the same value. Empty = unsigned.
CALLIGRAPHY_CALLBACK_SECRET=

# Worker sizing (per replica; scale replicas with --scale worker=N).
CALLIGRAPHY_CONCURRENCY=4
CALLIGRAPHY_AUTOSCALE=true
CALLIGRAPHY_MIN_CONCURRENCY=2
CALLIGRAPHY_MAX_CONCURRENCY=16

# Grafana admin (anonymous viewing is on regardless).
GRAFANA_ADMIN_PASSWORD=admin
